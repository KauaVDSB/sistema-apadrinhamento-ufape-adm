# ==============================================================================
# SISTEMA DE APADRINHAMENTO ACADÊMICO • BACHARELADO EM ADMINISTRAÇÃO (UFAPE)
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
#
# INSTRUÇÕES:
# 1. Copie este arquivo para um novo arquivo chamado .env na raiz do projeto:
#    cp .env.example .env
# 2. Preencha as credenciais obtidas no painel do Supabase (Project Settings -> API).
# 3. O arquivo .env está listado no .gitignore e nunca será enviado ao GitHub.
# ==============================================================================

# 1. URL DO PROJETO SUPABASE
# Onde encontrar: Painel Supabase -> Project Settings -> API -> Project URL
# Exemplo: https://abcdefghijklmnopqrst.supabase.co
SUPABASE_URL=https://seu-projeto.supabase.co

# 2. CHAVE PÚBLICA ANÔNIMA (ANON KEY / PUBLIC)
# Onde encontrar: Painel Supabase -> Project Settings -> API -> Project API keys -> anon (public)
# Esta chave é pública, segura para o navegador e protegida pelo Row Level Security (RLS).
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# 3. CHAVE DE SERVIÇO ADMINISTRATIVA (SERVICE ROLE KEY - OPCIONAL / BACKEND ONLY)
# Onde encontrar: Painel Supabase -> Project Settings -> API -> Project API keys -> service_role (secret)
# ATENÇÃO: NUNCA exponha esta chave no navegador ou no frontend!
SUPABASE_SERVICE_ROLE_KEY=

# 4. PORTA DO SERVIDOR DE DESENVOLVIMENTO LOCAL (HTTP)
PORT=3000

